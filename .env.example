# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI (or other LLM provider)
OPENAI_API_KEY=your_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Originality.ai for plagiarism/AI detection
ORIGINALITY_API_KEY=your_originality_ai_key

# Polar.sh (Merchant of Record for Pro Subscriptions)
POLAR_ACCESS_TOKEN=polar_oat_...
POLAR_PRO_MONTHLY_PRODUCT_ID=
POLAR_PRO_ANNUAL_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_CONNECT_CLIENT_ID=your_stripe_connect_client_id
STRIPE_PRO_MONTHLY_PRICE_ID=price_monthly_id
STRIPE_PRO_ANNUAL_PRICE_ID=price_annual_id

# Resend (Email)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=support@veralm.com

# Inngest (Background Jobs)
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Google Analytics 4 & AdSense
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT=1234567890
GA4_PROPERTY_ID=123456789
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
MONTHLY_SERVER_COST_USD=45

# Observability (Sentry & PostHog)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com